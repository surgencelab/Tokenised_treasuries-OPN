# Pipeline environment (copy to .env and fill in)

# Your Postgres connection string (the database you restored the dump into).
# Add ?sslmode=require if your Postgres needs TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tokenized_treasuries

# Your own Alchemy API key (free tier is sufficient): https://www.alchemy.com
# Enable all EVM networks on the app (Ethereum, BNB, Avalanche, Arbitrum,
# Optimism, Polygon, Base, Mantle, Solana).
ALCHEMY_API_KEY=your-alchemy-key-here
